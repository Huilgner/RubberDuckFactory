node_modules/
build/
dist/
architecture-map/node_modules/
architecture-map/dist/
coverage/

# Variáveis de ambiente e segredos
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.python-version

# Banco vetorial (dados locais gerados em runtime)
memory/chroma_db/
memory/__pycache__/
qdrant_storage/
*.sqlite3
*.db

# Workspace temporário do freelancer
temp_freelancer_workspace/

# Logs e artefatos de build
*.log
.DS_Store
.vscode/

# ── Propagação multiusuário: genoma no git, fenótipo local ─────────────────
# Squad local (stats, pontos, evolution de CADA usuário) — nunca versionar.
# O genoma compartilhável vive em agents/pool/ (versionado).
agents/active/*
!agents/active/.gitkeep
agents/clearance_memory/*
!agents/clearance_memory/.gitkeep

# Ledger, histórico e resíduos de projetos (briefings, custos, duelos,
# registro de arquivos) — dados sensíveis dos projetos de cada usuário.
project_ledger/*
!project_ledger/.gitkeep

# Flag de code freeze (estado local do deploy committee)
.code_freeze

# Saídas geradas por agentes em runtime
sites/

# uv / pip
.venv/
venv/
*.egg-info/

# =============================================================
# PROJETOS E BLUEPRINTS — nunca versionar neste repositório.
#
# O RDF é a plataforma; os projetos são dados de cada usuário.
# Blueprints carregam regra de negócio, nomes de cliente e decisões
# internas — continuidade privada, não código compartilhável.
# Caminhos configuráveis em .env (BLUEPRINTS_DIR, PROJECTS_ROOT).
# =============================================================

# Blueprints dos projetos (o diretório tem git próprio, sem remoto)
docs/blueprints/

# Projetos-filhos, caso algum seja clonado dentro da fábrica
# (o normal é viverem fora, em PROJECTS_ROOT)
projects/
SIGO_FENIX/
CastleVote/
visuau/
controle_obras/
SentinelaEdge/
RifaRegional/
ColheitaDeLaranjas/
