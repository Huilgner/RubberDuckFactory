# =============================================================
# Rubber Duck Factory — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env.
# =============================================================

# --- LLM / AI ---
# OpenRouter (roteador de modelos)  https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini (usado pelo orchestrator TypeScript)  https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude (acesso direto à API)  https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# --- MEMÓRIA VETORIAL ---
# Qdrant — URL do servidor (local ou cloud)
QDRANT_URL=http://localhost:6333
# Qdrant — API key (obrigatório apenas em modo cloud)  https://cloud.qdrant.io
QDRANT_API_KEY=

# --- APLICAÇÃO ---
# URL pública onde o serviço está hospedado (para OAuth callbacks, links, etc.)
APP_URL=http://localhost:3000

# --- PROJETOS E BLUEPRINTS ---
# Nada aqui é versionado: blueprints e projetos são dados privados de cada
# usuário do RDF, não código da plataforma. Ver .gitignore.

# Diretório de blueprints dos projetos (repositório git próprio, local)
BLUEPRINTS_DIR=docs/blueprints

# Raiz onde vivem os projetos-filhos (SIGO_FENIX, CastleVote, Vis.Uau, …).
# Eles moram FORA da fábrica; a plataforma só aponta para eles.
PROJECTS_ROOT=C:\

# Exceção conhecida: launcher/index.html é HTML estático (zero token, zero
# servidor — BP_DEC01 D4) e por isso carrega os caminhos inline no array
# PRODUTOS. É o único lugar que não lê estas variáveis.
