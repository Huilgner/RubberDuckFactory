{
  "patterns": [
    { "glob": "board/**/*.tsx",              "agent": "Nova",   "tier": 2 },
    { "glob": "board/**/*.ts",               "agent": "Nova",   "tier": 2 },
    { "glob": "board/**/*.css",              "agent": "Nova",   "tier": 2 },
    { "glob": "board/**/*.html",             "agent": "Nova",   "tier": 2 },
    { "glob": "server.py",                   "agent": "Chen",   "tier": 2 },
    { "glob": "server*.py",                  "agent": "Chen",   "tier": 2 },
    { "glob": "main.py",                     "agent": "Chen",   "tier": 2 },
    { "glob": "cost_tracker.py",             "agent": "Chen",   "tier": 2 },
    { "glob": "agents/agent_runner.py",      "agent": "Chen",   "tier": 2 },
    { "glob": "agents/pleno_rag_worker.py",  "agent": "Chen",   "tier": 2 },
    { "glob": "orchestrator/**",             "agent": "Chen",   "tier": 2 },
    { "glob": "docker-compose*.yaml",        "agent": "Atlas",  "tier": 2 },
    { "glob": "docker-compose*.yml",         "agent": "Atlas",  "tier": 2 },
    { "glob": "Dockerfile*",                 "agent": "Atlas",  "tier": 2 },
    { "glob": "quality_gate_server.py",      "agent": "Shadow", "tier": 3 },
    { "glob": "sovereign_proxy.py",          "agent": "Shadow", "tier": 3 },
    { "glob": ".governance/**",              "agent": "Shadow", "tier": 3 },
    { "glob": "architecture-map/**",         "agent": "Shadow", "tier": 3 },
    { "glob": "docs/ADR-*",                  "agent": "Quill",  "tier": 1 },
    { "glob": "docs/**/*.md",                "agent": "Quill",  "tier": 1 },
    { "glob": "README.md",                   "agent": "Falcon", "tier": 1 },
    { "glob": "README*",                     "agent": "Falcon", "tier": 1 },
    { "glob": "CLAUDE.md",                   "agent": "Quill",  "tier": 1 }
  ],
  "exempt": [
    ".claude/**",
    "agents/active/**",
    "agents/blacklist/**",
    "agents/file_ownership.json",
    "agents/clearance_memory/**",
    "project_ledger/**",
    "memory/**",
    "qdrant_storage/**",
    ".env",
    ".env.*",
    "pyproject.toml",
    "package.json",
    "tsconfig.json",
    "uv.lock",
    "*.lock",
    "metadata.json",
    "assets/**"
  ],
  "_note": "Adicione padrões conforme o projeto cresce. 'glob' usa fnmatch relativo ao root do projeto."
}
